# Node Environment
NODE_ENV=development
PORT=5000

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/teacher_management_db

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging Level
LOG_LEVEL=info

# Google Gemini API Key (Phase 7)
GEMINI_API_KEY=
